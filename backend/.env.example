PORT=3000
HOST=127.0.0.1
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Em uma publicação com HTTPS, defina NODE_ENV=production para exigir cookie Secure.
DATABASE_URL="postgresql://integrahub_user:troque_a_senha@127.0.0.1:5432/integrahub?schema=public"
INTEGRATION_TIMEOUT_MS=15000
# Máximo global de chamadas externas simultâneas (1 a 10).
EXECUTION_CONCURRENCY=3
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
